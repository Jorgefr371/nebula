# Copia este fichero a .env.local y rellena las claves.

# ---------------------------------------------------------------------------
# Modelo. Basta con UNA de las dos.
# Si están las dos, gana OpenAI; MODEL_PROVIDER fuerza una concreta.
# Solo se usan en el servidor; nunca llegan al navegador.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.2

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# MODEL_PROVIDER=openai

# ---------------------------------------------------------------------------
# Supabase. Panel del proyecto → Settings → API.
# La publishable key es pública por diseño: quien protege los datos es RLS.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# GitHub OAuth App (opcional, solo para exportar a GitHub).
# https://github.com/settings/developers
# Authorization callback URL: http://localhost:3100/api/github/callback
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
